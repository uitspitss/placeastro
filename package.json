{
  "name": "placeastro-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "knip": "knip",
    "clean": "pnpm run --recursive clean && rm -rf .turbo",
    "clean:all": "pnpm clean && rm -rf node_modules pnpm-lock.yaml",
    "types:generate": "pnpm --filter @placeastro/api wrangler:types",
    "db:generate": "pnpm --filter @placeastro/database generate",
    "db:migrate": "pnpm --filter @placeastro/database migrate:local",
    "db:studio": "pnpm --filter @placeastro/database studio",
    "db:seed": "pnpm --filter @placeastro/database seed:local",
    "setup": "pnpm install && pnpm types:generate && pnpm db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@dotenvx/dotenvx": "latest",
    "@tanstack/intent": "catalog:",
    "knip": "^5.86.0",
    "lefthook": "^2.1.4",
    "turbo": "^2.8.14",
    "typescript": "^5"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
