{
  "name": "@placeastro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/client-types.ts",
  "types": "./src/client-types.ts",
  "scripts": {
    "dev": "pnpm run migrate:local; mkdir -p ../web/dist; portless run --name api -- sh -c 'wrangler dev --local --persist-to .wrangler/state --port $PORT'",
    "migrate:local": "wrangler d1 execute DB --local --file=../../packages/database/drizzle/0000_init.sql; wrangler d1 execute DB --local --file=../../packages/database/drizzle/0001_auth.sql; wrangler d1 execute DB --local --file=../../packages/database/drizzle/seed.sql",
    "deploy:dry-run": "wrangler deploy --env production --dry-run --outdir dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules .wrangler",
    "wrangler:types": "wrangler types --env-file .dev.vars.example && mv worker-configuration.d.ts src/types/worker-configuration.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@orpc/client": "^1.4.3",
    "@orpc/server": "^1.4.3",
    "@placeastro/database": "workspace:*",
    "@placeastro/shared": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "@sentry/hono": "catalog:",
    "better-auth": "^1.6.13",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "neverthrow": "catalog:",
    "wrangler": "^4.71.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
