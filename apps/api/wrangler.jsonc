{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placeastro-api",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // web のビルド成果物（dist/docs）。一致するパスは Worker を通らずに配信される。
  // single-page-application にすると API へのナビゲーションまで index.html に
  // 吸われるので、/docs 配下のフォールバックは routes/spa-routes.ts で行う
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Dev settings (port は portless の PORT 環境変数で自動割当。固定する場合は "port": 8080 を追加)
  "dev": {
    "local_protocol": "http",
    "upstream_protocol": "https"
  },

  // Default: local development
  "vars": {
    "CORS_ORIGIN": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:3000",
    // "true" のときだけ better-auth のサインアップが開く（lib/auth.ts）。
    // E2E は既定 vars のまま wrangler dev を起動するのでここが効く
    "ALLOW_SIGN_UP": "true",
    "IMGIX_HOSTNAME": "placeastro-dev.imgix.net",
    "R2_BUCKET": "placeastro-dev",
    "UMAMI_HOST": "https://cloud.umami.is",
    "UMAMI_WEBSITE_ID": "0b51e2f3-638d-4b87-82a3-30c6c317927e"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "placeastro-dev",
      "database_id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "placeastro-dev"
    }
  ],
  "observability": {
    "enabled": false
  },

  // Production environment
  "env": {
    "production": {
      // 省くと wrangler は "placeastro-api-production" という別ワーカーを作る
      "name": "placeastro-api",
      "workers_dev": true,
      "vars": {
        "CORS_ORIGIN": "https://placeastro.u7s.dev",
        "BETTER_AUTH_URL": "https://placeastro.u7s.dev",
        // 省いても閉じるが、閉じているのが意図だと分かるよう明示する
        "ALLOW_SIGN_UP": "false",
        "IMGIX_HOSTNAME": "placeastro-r2.imgix.net",
        "R2_BUCKET": "placeastro",
        "UMAMI_HOST": "https://cloud.umami.is",
        "UMAMI_WEBSITE_ID": "0b51e2f3-638d-4b87-82a3-30c6c317927e"
      },
      "routes": [
        {
          "pattern": "placeastro.u7s.dev/*",
          "zone_name": "u7s.dev"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "placeastro",
          "database_id": "cea447ae-8fa0-4755-a225-bfb55009d411"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "placeastro"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
