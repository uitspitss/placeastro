# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
.next/
out/

# production
build/
dist/

# turbo
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.keys
# 本番 URL は CI の変数から渡す（.github/workflows/ci.yml の deploy-web 参照）。
# ローカルには置いたままでよく、vite build がそのまま拾う
.env.production
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare
.wrangler/
.miniflare/
worker-configuration.d.ts

# open-next
.open-next

# Database
*.db
*.db-shm
*.db-wal
.drizzle/

# IDE
.vscode/
.idea/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Playwright
.playwright-mcp/
# apps/web 配下に出る。biome の vcs.useIgnoreFile がサブディレクトリから
# 効くよう、パス先頭にスラッシュを付けない
test-results/
playwright-report/
blob-report/
# スラッシュを含むパターンはリポジトリルート起点になるので **/ を付ける
**/playwright/.cache/
# 有効なセッション Cookie が入る
**/e2e/.auth/


# superpowers plans
docs/superpowers/

# エージェントのローカル設定と、第三者配布の vendored skill。
# どちらもこの製品ではないので追跡しない（各自ローカルに置く前提）。
# settings.json だけはワークツリーやクラウドのセッションでも効かせるため追跡する
**/.claude/*
!/.claude/settings.json
.agents/

*storybook.log
storybook-static

# design-sync（.design-sync/ の残りは再同期で使うので追跡する）
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/
.design-sync/ds-package/types/
