{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [".claude/**"],
  "ignoreBinaries": ["portless", "wrangler"],
  // AGENTS.md の指示でエージェントが `pnpm exec intent` として呼ぶだけで、コードからは参照しない
  "ignoreDependencies": ["@tanstack/intent"],
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "exports": "warn",
    "types": "warn"
  },
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "playwright": {
        "config": ["playwright.config.ts"],
        // 既定の entry は *.spec.ts だけなので、setup project の
        // *.setup.ts を足さないと未使用ファイル扱いになる
        "entry": ["e2e/**/*.{spec,setup}.ts"]
      },
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "apps/api": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/database": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
